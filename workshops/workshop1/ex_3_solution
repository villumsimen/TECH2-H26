import numpy as np

#We make a function, called tax as function of income
def tax(income):
    #overall, we use if elif else as these are exclusive, if if if, would have made 900k run 2x. both larger
    #if income is less than 300k, no taxes
    if income <= 300_000:
        tax_owed = 0
#if income less than 700k we know that it is more than 300k since it was not flagged previousely, so we know it is between 300k and 700k
    elif income <= 700_000:
#we apply tax rate only on income above the 300k
        tax_owed = (income - 300_000) * 0.2
#if a income made it this far it is larger than 700k.
    else:
#we apply tax rate. income falling in b2 is only whats over 700k, income falling in b1 is 400_000 as it maxes that bracket. then we apply the relevant rates for each bracket
         bracket2 = income - 700_000
         bracket1 = 700_000-300_000
         tax_owed = bracket2 * 0.35 + bracket1 * 0.2 
        
#returning function for the tax owed. 
    return tax_owed
