incomes = np.linspace(0,1_200_000,13)
#function of incomes array
def tax_numpy(incomes):
#we define low incomes as np.minimun, of incomes and 300 000, minimum chooses the smallest of the two. ie all incomes less than 300k gets chosen. 
    low_incomes = np.minimum(incomes, 300_000)   
#Again we define middle incomes as the less then 700k, np min chooses every income less than 700k 
    middle_incomes = np.minimum(incomes,700_000)
#the middle slice of the income is 
    middle_slice = (middle_incomes - low_incomes)*0.2
#high incomes picks the largest of incomes and 700k. 
    high_incomes = np.maximum(incomes,700_000)
#the part of income thats high slice is the part over 700k and rate is 0.35
    high_slice = (high_incomes - 700_000) * 0.35
#tax_owed is going to be the high slice + the middle. for the incomes under these thresholds you just get 700 000 - 700 000 = 0 
    tax_owed = high_slice + middle_slice

    return tax_owed
    
    
taxes_numpy = tax_numpy(incomes)
print(np.allclose(taxes_numpy, taxes_loop))
    




    




